CREATE TABLE `event` (
	`id`	UUID	NOT NULL,
	`store_id`	UUID	NOT NULL,
	`service_id`	UUID	NULL,
	`title`	VARCHAR(200)	NOT NULL,
	`event_type`	VARCHAR(30)	NOT NULL,
	`description`	TEXT	NULL,
	`discount_rate`	DECIMAL(5,2)	NULL,
	`img_url`	VARCHAR(255)	NULL,
	`start_date`	DATE	NOT NULL,
	`end_date`	DATE	NOT NULL,
	`status`	VARCHAR(20)	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `task_checklist` (
	`id`	UUID	NOT NULL,
	`schedule_id`	UUID	NULL,
	`customer_id`	UUID	NULL,
	`title`	VARCHAR(200)	NOT NULL,
	`task_type`	VARCHAR(30)	NOT NULL,
	`due_date`	DATE	NULL,
	`is_done`	BOOLEAN	NOT NULL	DEFAULT FALSE,
	`done_at`	TIMESTAMPTZ	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `event_target` (
	`id`	UUID	NOT NULL,
	`customer_id`	UUID	NOT NULL,
	`event_id`	UUID	NOT NULL,
	`status`	VARCHAR(30)	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `follow_up_ai_insight` (
	`follow_up_id`	UUID	NOT NULL,
	`persuasion_point`	JSONB	NOT NULL	DEFAULT '',
	`caution_note`	TEXT	NULL,
	`action_basis`	TEXT	NOT NULL	DEFAULT '{}',
	`analyzed_at`	TIMESTAMPTZ	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `message_template` (
	`id`	UUID	NOT NULL,
	`follow_up_id`	UUID	NULL,
	`event_target_id`	UUID	NULL,
	`customer_id`	UUID	NOT NULL,
	`message_id`	VARCHAR(100)	NULL,
	`content`	TEXT	NOT NULL,
	`version_type`	VARCHAR(20)	NOT NULL,
	`tone_preset`	VARCHAR(20)	NOT NULL,
	`delivery_status`	VARCHAR(20)	NULL,
	`scheduled_at`	TIMESTAMPTZ	NOT NULL,
	`generated_at`	TIMESTAMPTZ	NOT NULL,
	`sent_at`	TIMESTAMPTZ	NULL,
	`delivered_at`	TIMESTAMPTZ	NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `consultation` (
	`id`	UUID	NOT NULL,
	`customer_id`	UUID	NOT NULL,
	`user_id`	UUID	NOT NULL,
	`session_no`	INT	NULL,
	`stage`	VARCHAR(20)	NOT NULL,
	`summary`	TEXT	NULL,
	`source_type`	VARCHAR(10)	NOT NULL	DEFAULT 'DIRECT',
	`raw_text`	TEXT	NOT NULL,
	`visit_purpose`	TEXT	NULL,
	`experience_note`	TEXT	NULL,
	`positive_signal`	TEXT	NULL,
	`extra_note`	TEXT	NULL,
	`ai_parsed_at`	TIMESTAMPTZ	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `user` (
	`id`	UUID	NOT NULL,
	`store_id`	UUID	NOT NULL,
	`name`	VARCHAR(50)	NOT NULL,
	`email`	VARCHAR(100)	NOT NULL,
	`role`	VARCHAR(30)	NOT NULL	DEFAULT 'STAFF',
	`password`	TEXT	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `store` (
	`id`	UUID	NOT NULL,
	`name`	VARCHAR(100)	NOT NULL,
	`store_type`	VARCHAR(50)	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `follow_up` (
	`id`	UUID	NOT NULL,
	`consultation_id`	UUID	NOT NULL,
	`recommend_contact_date`	DATE	NOT NULL,
	`status`	VARCHAR(30)	NOT NULL	DEFAULT 'PENDING',
	`snoozed_until`	DATE	NULL,
	`memo`	TEXT	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `interest_service` (
	`id`	UUID	NOT NULL,
	`customer_id`	UUID	NOT NULL,
	`service_id`	UUID	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `service` (
	`id`	UUID	NOT NULL,
	`store_id`	UUID	NOT NULL,
	`name`	VARCHAR(100)	NOT NULL,
	`description`	TEXT	NULL,
	`price`	DECIMAL(10,2)	NULL,
	`is_active`	BOOLEAN	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `customer` (
	`id`	UUID	NOT NULL,
	`store_id`	UUID	NOT NULL,
	`service_id`	UUID	NOT NULL,
	`name`	VARCHAR(50)	NOT NULL,
	`gender`	VARCHAR(10)	NULL,
	`phone_num`	VARCHAR(20)	NULL,
	`inflow_path`	VARCHAR(30)	NULL	DEFAULT 'OTHER',
	`status`	VARCHAR(20)	NOT NULL	DEFAULT 'UNREGISTERED',
	`first_consult_at`	DATE	NOT NULL,
	`latest_consult_at`	DATE	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `non_conversion_reason` (
	`id`	UUID	NOT NULL,
	`customer_id`	UUID	NOT NULL,
	`consultation_id`	UUID	NULL,
	`reason_type`	VARCHAR(50)	NOT NULL,
	`role`	VARCHAR(20)	NULL	DEFAULT 'PRIMARY',
	`reason_basis`	TEXT	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL,
	`confidence`	VARCHAR(20)	NULL
);

CREATE TABLE `contact_result` (
	`id`	UUID	NOT NULL,
	`customer_id`	UUID	NOT NULL,
	`follow_up_id`	UUID	NULL,
	`result_status`	VARCHAR(20)	NOT NULL	DEFAULT 'NOT_CONTACTED',
	`result_date`	DATE	NOT NULL,
	`memo`	TEXT	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `schedule` (
	`id`	UUID	NOT NULL,
	`store_id`	UUID	NOT NULL,
	`customer_id`	UUID	NULL,
	`consultation_id`	UUID	NULL,
	`title`	VARCHAR(200)	NOT NULL,
	`schedule_type`	VARCHAR(30)	NOT NULL,
	`start_at`	TIMESTAMPTZ	NOT NULL,
	`end_at`	TIMESTAMPTZ	NOT NULL,
	`memo`	TEXT	NULL,
	`created_by`	UUID	NOT NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `consultation_signal` (
	`id`	UUID	NOT NULL,
	`consultation_id`	UUID	NOT NULL,
	`signal_type`	VARCHAR(50)	NOT NULL,
	`signal_value`	VARCHAR(50)	NOT NULL,
	`confidence`	VARCHAR(20)	NULL,
	`evidence_text`	TEXT	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL
);

CREATE TABLE `customer_ai_insight` (
	`customer_id`	UUID	NOT NULL,
	`lead_temperature`	VARCHAR(20)	NULL,
	`temperature_basis`	TEXT	NULL,
	`priority_score`	INT	NULL,
	`analyzed_at`	TIMESTAMPTZ	NULL,
	`created_at`	TIMESTAMPTZ	NOT NULL,
	`updated_at`	TIMESTAMPTZ	NOT NULL
);

